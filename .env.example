# R.A. Omega local environment template
# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.

# Local development
ATLAS_DISABLE_AUTH=true
ATLAS_ALLOW_UNSIGNED_STRIPE_WEBHOOK=false
ATLAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
ATLAS_DEFAULT_SUBSCRIPTION_TIER=free
ATLAS_DATA_CACHE_DIR=
ATLAS_TIER_FREE_DAILY_QUERIES=5
ATLAS_TIER_PRO_DAILY_QUERIES=999999
ATLAS_TIER_BUSINESS_DAILY_QUERIES=999999

# Core AI providers
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
GEMINI_SYNTHESIS_MAX_TOKENS=8192
OPENAI_API_KEY=

# Voice / TTS
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Supabase auth, history, sessions, positions, watchlist
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Developer API endpoint (/api/v1/query)
ATLAS_DEV_API_KEY=
ATLAS_DEV_API_KEYS=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# Broker and market data integrations
TRADIER_TOKEN=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=True

# Optional backtest, news, and screen watcher tuning
BACKTEST_CACHE_TTL_H=24
BACKTEST_LOOKBACK_YEARS=5
BACKTEST_FORWARD_DAYS=10
NEWS_SCAN_INTERVAL_MIN=5
SCREEN_WATCHER_SAVE=false
SCREEN_WATCHER_ARCHIVE=false

# Optional Robinhood integration
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_MFA_CODE=
ROBINHOOD_CHALLENGE_CODE=
ROBINHOOD_JOINT_ACCOUNT_NUMBER=
ROBINHOOD_JOINT_ACCOUNT_NUMBERS=
ROBINHOOD_INDIVIDUAL_ACCOUNT_NUMBER=
ROBINHOOD_INDIVIDUAL_ACCOUNT_NUMBERS=
ROBINHOOD_POSITIONS_ACCOUNT_FILTER=all
ROBINHOOD_DEVICE_POLL_SEC=180
ROBINHOOD_DEVICE_POLL_INTERVAL_SEC=3
RH_MANUAL_STOCKS=
RH_MANUAL_OPTIONS=
MARKET_TZ=America/New_York
OPTIONS_DTE_LIST=21,30,45,60
MAX_ASK_PER_SHARE=0.50

# Digest email
DIGEST_EMAIL=
DIGEST_TZ=America/New_York
DIGEST_FROM_EMAIL=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Evaluation runner
ATLAS_EVAL_TOKEN=
ATLAS_TEST_JWT=
SUPABASE_ACCESS_TOKEN=
ATLAS_EVAL_INTER_QUERY_SLEEP=0
ATLAS_EVAL_429_RETRY_SLEEP=65
