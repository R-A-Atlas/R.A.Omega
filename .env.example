# R.A. Omega — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git. This .env.example is safe to commit.
# All values marked YOUR_... are placeholders.

# ── Supabase (database + auth) ────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Google AI (Gemini — LLM synthesis) ───────────────────────────────────────
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID_STARTER=price_YOUR_STARTER_PRICE_ID
STRIPE_PRICE_ID_PRO=price_YOUR_PRO_PRICE_ID

# ── OpenAI (Whisper voice transcription + TTS) ────────────────────────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
OPENAI_TTS_VOICE=alloy

# ── ElevenLabs (alternative TTS) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID

# ── Email digest (SendGrid or SMTP) ──────────────────────────────────────────
DIGEST_EMAIL=your@email.com
DIGEST_FROM_EMAIL=atlas@yourdomain.com
DIGEST_TZ=America/New_York
SENDGRID_API_KEY=SG.YOUR_SENDGRID_API_KEY
# SMTP alternative (use instead of SendGrid):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=YOUR_APP_PASSWORD

# ── Local dev flag ────────────────────────────────────────────────────────────
ATLAS_DISABLE_AUTH=true

# ── Developer API ─────────────────────────────────────────────────────────────
ATLAS_DEV_API_KEY=YOUR_DEV_API_KEY

# ────────────────────────────────────────────────────────────────────────────
# PLANNED CONNECTIONS — not yet wired; add credentials when ready
# ────────────────────────────────────────────────────────────────────────────

# ── Google OAuth2 (Drive, Docs, Sheets, Gmail, Calendar) ─────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN_GMAIL=YOUR_GMAIL_REFRESH_TOKEN
GOOGLE_REFRESH_TOKEN_CALENDAR=YOUR_CALENDAR_REFRESH_TOKEN
GOOGLE_REFRESH_TOKEN_DRIVE=YOUR_DRIVE_REFRESH_TOKEN

# ── Google Workspace Export (Docs + Sheets + Drive) ───────────────────────────
# Set GOOGLE_WORKSPACE_ENABLED=true once credentials are configured.
# GOOGLE_REFRESH_TOKEN is the consolidated Drive+Docs+Sheets refresh token.
# GOOGLE_DRIVE_REPORTS_FOLDER_ID is the folder where exports are saved.
GOOGLE_WORKSPACE_ENABLED=false
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
GOOGLE_DRIVE_REPORTS_FOLDER_ID=YOUR_FOLDER_ID

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_YOUR_GITHUB_FINE_GRAINED_TOKEN

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── ClickUp ───────────────────────────────────────────────────────────────────
CLICKUP_API_KEY=YOUR_CLICKUP_API_KEY
CLICKUP_LIST_ID=YOUR_CLICKUP_LIST_ID

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=YOUR_NOTION_INTEGRATION_TOKEN
NOTION_DATABASE_ID=YOUR_NOTION_DATABASE_ID

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-YOUR_SLACK_BOT_TOKEN
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
SLACK_CHANNEL_ID=YOUR_SLACK_CHANNEL_ID

# ── SEC EDGAR (free public API — no key, but User-Agent required) ────────────
# Replace with your real app name and contact email per SEC terms of service.
# Format: "Application Name contact@yourdomain.com"
# When set, SEC EDGAR becomes an active connection in omega_connections.py.
SEC_USER_AGENT=R.A. Omega contact@example.com

# ── Market data (authenticated fallbacks for yfinance) ───────────────────────
ALPHA_VANTAGE_KEY=YOUR_ALPHA_VANTAGE_API_KEY
POLYGON_API_KEY=YOUR_POLYGON_API_KEY
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY

# ── Broker API (read-only; NEVER enable write/trading without explicit opt-in) ─
BROKER_API_KEY=YOUR_BROKER_API_KEY
BROKER_API_SECRET=YOUR_BROKER_API_SECRET
BROKER_BASE_URL=https://paper-api.alpaca.markets
