    "daily_priority_brief":           {"day_of_week": "mon-fri", "hour": 12, "minute": 30},
    "weekly_portfolio_review":        {"day_of_week": "sun",     "hour": 22, "minute": 0},
    "weekly_omega_os_audit":          {"day_of_week": "mon",     "hour": 13, "minute": 0},
    "weekly_product_review":          {"day_of_week": "mon",     "hour": 14, "minute": 0},
    "monthly_finance_report":         {"day": 1,                 "hour": 12, "minute": 0},
    "monthly_product_roadmap_review": {"day": "last fri",        "hour": 19, "minute": 0}
